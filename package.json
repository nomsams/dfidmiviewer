{
  "name": "dfi-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --import ./scripts/test-loader.mjs --test tests/*.test.ts",
    "verify:pdf": "node --experimental-strip-types --import ./scripts/test-loader.mjs scripts/verify-pdf.ts",
    "dev": "vite",
